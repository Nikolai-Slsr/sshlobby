#!/usr/bin/env bash
# Test-Stub für docker. Im CT $PD_CT (Aufruf über den incus-Stub) Fixture $PD_FIX/docker/<ct>,
# ohne PD_CT (Host-Docker) Fixture $PD_FIX/host-docker. Zeilenformat:
#   name|image|state|status|ports|compose-dir|projekt|service|restart-policy  (ab Feld 6 optional)
# Steuerung: PD_DOCKER_DOWN=1 bzw. STUB_HOST_DOCKER=down (Daemon aus), STUB_LOGS_SLEEP=<s>
#   (logs -f blockiert), STUB_GONE=<name> + STUB_GONE_AFTER=<n> (Container fehlt ab dem n+1.
#   "ps -a"), STUB_EXEC_RC=<n> (Exit-Code der Shell bei docker exec), STUB_ACTION_RC=<n>
#   (Exit-Code von restart/stop/start und compose restart/stop/start).
# Werkzeuge (Daten aus $PD_FIX/tools/docker, Endung .host bzw. .<ct>): "stats" (stats.*),
#   inspect im Format des Hermes-Scanners (enthält HERMES_HOME=): Zeilen aus tools/docker/hermes.<ct|host>,
#   sonst eine neutrale Zeile ohne Hermes-Merkmale. "pull" gibt nur STUB-PULL aus.
#   "system df" (system-df.txt), "system df -v" (system-df-v.*), inspect-Platzhalter
#   RestartCount/OOMKilled/ExitCode aus inspect-extra.* (name|restarts|oom|exitcode).
#   inspect ohne --format: JSON wie docker inspect, aus der Zeile erzeugt (State, RestartCount,
#   RestartPolicy; bei Healthcheck im Status-Text auch State.Health mit zwei Prüfungen und
#   Config.Healthcheck), STUB_INSPECT_RC=<n> lässt es scheitern.
# Jeder Aufruf wird in $STUB_LOG protokolliert (ein Argument pro Zeile).
set -u
FIX=${PD_FIX:?PD_FIX fehlt}
CT=${PD_CT:-}

{ echo "== docker@${CT:-host}"; printf '  %s\n' "$@"; } >> "${STUB_LOG:-/dev/null}"

if [ -n "${PD_DOCKER_DOWN:-}" ] || { [ -z "$CT" ] && [ "${STUB_HOST_DOCKER:-}" = down ]; }; then
  echo "Cannot connect to the Docker daemon at unix:///var/run/docker.sock. Is the docker daemon running?" >&2
  exit 1
fi

if [ -n "$CT" ]; then DATA="$FIX/docker/$CT"; else DATA="$FIX/host-docker"; fi
[ -f "$DATA" ] || DATA=/dev/null

rows() { # gibt die sichtbaren Container-Zeilen aus
  local gone=""
  if [ -n "${STUB_GONE:-}" ]; then
    local n=0; [ -f "$FIX/.pscount" ] && n=$(<"$FIX/.pscount")
    [ "$n" -gt "${STUB_GONE_AFTER:-0}" ] && gone=$STUB_GONE
  fi
  awk -F'|' -v g="$gone" 'NF>=4 && $1!=g' "$DATA"
}
find_row() { rows | awk -F'|' -v n="$1" '$1==n{print; exit}'; }
no_such() { echo "Error response from daemon: No such container: $1" >&2; exit 1; }

json() { # zeile → JSON-Objekt wie in docker inspect (nur die Felder, die sshlobby liest)
  local name image state status ports dir proj svc policy x restarts=0 oom=false code=0 health=""
  IFS='|' read -r name image state status ports dir proj svc policy <<< "$1"
  x=$(awk -F'|' -v n="$name" '$1==n' "$FIX/tools/docker/inspect-extra.${CT:-host}" 2>/dev/null)
  [ -n "$x" ] && IFS='|' read -r _ restarts oom code <<< "$x"
  [ "$state" = exited ] && [ -z "$x" ] && code=$(sed -n 's/^Exited (\([0-9]*\)).*/\1/p' <<< "$status")
  case "$status" in *"(unhealthy)"*) health=unhealthy;; *"health: starting"*) health=starting;; *"(healthy)"*) health=healthy;; esac
  jq -cn --arg n "/$name" --arg img "$image" --arg st "$state" --arg pol "${policy:-no}" --argjson rs "${restarts:-0}" \
    --argjson oom "${oom:-false}" --argjson code "${code:-0}" --arg h "$health" '
    { Name: $n, RestartCount: $rs, HostConfig: { RestartPolicy: { Name: $pol } }, Config: { Image: $img },
      State: { Status: $st, ExitCode: $code, OOMKilled: $oom, Error: "",
               StartedAt: "2026-10-09T12:00:00.123456789Z",
               FinishedAt: (if $st == "running" then "0001-01-01T00:00:00Z" else "2026-09-15T08:00:00.5Z" end) } }
    | if $h == "" then . else
        .Config.Healthcheck = { Test: ["CMD-SHELL", "curl -f http://localhost/ || exit 1"] }
        | .State.Health = { Status: $h, FailingStreak: (if $h == "unhealthy" then 3 else 0 end),
            Log: (if $h == "unhealthy"
                  then [ { Start: "2026-10-13T09:09:30.1Z", ExitCode: 0, Output: "OK" },
                         { Start: "2026-10-13T09:10:00.2Z", ExitCode: 1, Output: "curl: (7) Failed to connect\nto localhost port 80" } ]
                  else [ { Start: "2026-10-13T09:10:00.2Z", ExitCode: 0, Output: "OK" } ] end) } end'
}

fill() { # format zeile → Platzhalter ersetzen
  local out=$1 name image state status ports dir proj svc policy
  IFS='|' read -r name image state status ports dir proj svc policy <<< "$2"
  out=${out//'{{.Names}}'/"$name"}; out=${out//'{{.Name}}'/"/$name"}; out=${out//'{{.Image}}'/"$image"}
  out=${out//'{{.State}}'/"$state"}; out=${out//'{{.Status}}'/"$status"}
  out=${out//'{{.Ports}}'/"$ports"}
  out=${out//'{{.Label "com.docker.compose.project"}}'/"$proj"}
  out=${out//'{{.Label "com.docker.compose.service"}}'/"$svc"}
  out=${out//'{{.Label "com.docker.compose.project.working_dir"}}'/"$dir"}
  out=${out//'{{index .Config.Labels "com.docker.compose.project.working_dir"}}'/"$dir"}
  out=${out//'{{.HostConfig.RestartPolicy.Name}}'/"${policy:-no}"}
  if [[ $out == *'{{.RestartCount}}'* || $out == *'{{.State.'* ]]; then
    local x restarts=0 oom=false code=0
    x=$(awk -F'|' -v n="$name" '$1==n' "$FIX/tools/docker/inspect-extra.${CT:-host}" 2>/dev/null)
    [ -n "$x" ] && IFS='|' read -r _ restarts oom code <<< "$x"
    [ "$state" = exited ] && [ -z "$x" ] && code=$(sed -n 's/^Exited (\([0-9]*\)).*/\1/p' <<< "$status")
    out=${out//'{{.RestartCount}}'/"$restarts"}; out=${out//'{{.State.OOMKilled}}'/"$oom"}
    out=${out//'{{.State.ExitCode}}'/"${code:-0}"}; out=${out//'{{.State.Status}}'/"$state"}
  fi
  printf '%s\n' "$out"
}

cmd=${1:-}; shift
case "$cmd" in
  ps)
    all=0 fmt="{{.Names}}"
    while [ $# -gt 0 ]; do
      case "$1" in -a) all=1;; -aq|-qa) all=1; fmt="{{.Names}}";; -q) fmt="{{.Names}}";; --format) fmt=$2; shift;; esac; shift
    done
    if [ "$all" -eq 1 ]; then
      n=0; [ -f "$FIX/.pscount" ] && n=$(<"$FIX/.pscount"); echo $((n+1)) > "$FIX/.pscount"
    fi
    while IFS= read -r row; do
      state=$(printf '%s' "$row" | cut -d'|' -f3)
      [ "$all" -eq 1 ] || [ "$state" = running ] || continue
      fill "$fmt" "$row"
    done < <(rows);;
  inspect)
    fmt=""; [ "${1:-}" = "--format" ] && { fmt=$2; shift 2; }
    if [ -z "$fmt" ]; then                      # JSON-Liste wie docker inspect
      [ -n "${STUB_INSPECT_RC:-}" ] && { echo "Error: inspect kaputt" >&2; exit "$STUB_INSPECT_RC"; }
      out=() rc=0
      for name in "$@"; do
        row=$(find_row "$name")
        if [ -z "$row" ]; then echo "Error: No such object: $name" >&2; rc=1; continue; fi
        out+=("$(json "$row")")
      done
      [ ${#out[@]} -gt 0 ] && printf '%s\n' "${out[@]}" | jq -s .
      exit "$rc"
    fi
    rc=0
    for name in "$@"; do
      row=$(find_row "$name")
      if [ -z "$row" ]; then echo "Error: No such object: $name" >&2; rc=1; continue; fi
      if [[ $fmt == *'HERMES_HOME='* ]]; then # Hermes-Scanner: Zeile aus tools/docker/hermes.<ct|host>
        x=$(awk -F'|' -v n="/$name" '$1==n{print; exit}' "$FIX/tools/docker/hermes.${CT:-host}" 2>/dev/null)
        [ -n "$x" ] || x="/$name|$(cut -d'|' -f3 <<< "$row")|$(cut -d'|' -f2 <<< "$row")| sh||"
        printf '%s\n' "$x"; continue
      fi
      fill "$fmt" "$row"
    done
    exit "$rc";;
  exec)
    while [[ "${1:-}" == -* ]]; do shift; done
    row=$(find_row "${1:-}"); [ -n "$row" ] || no_such "${1:-}"
    [ "$(printf '%s' "$row" | cut -d'|' -f3)" = running ] \
      || { echo "Error response from daemon: container $1 is not running" >&2; exit 1; }
    echo "STUB-DOCKER-EXEC ${CT:-host}/$1"; exit "${STUB_EXEC_RC:-0}";;
  logs)
    while [[ "${1:-}" == -* ]]; do [ "$1" = "--tail" ] && shift; shift; done
    [ -n "$(find_row "${1:-}")" ] || no_such "${1:-}"
    echo "log line from $1"
    if [ -n "${STUB_LOGS_SLEEP:-}" ]; then
      touch "$FIX/.logs-running"
      exec sleep "$STUB_LOGS_SLEEP"
    fi;;
  restart|stop|start)
    [ -n "$(find_row "${1:-}")" ] || no_such "${1:-}"
    echo "$1"; exit "${STUB_ACTION_RC:-0}";;
  pull)
    echo "STUB-PULL ${1:-}"; exit "${STUB_ACTION_RC:-0}";;
  stats)
    cat "$FIX/tools/docker/stats.${CT:-host}" 2>/dev/null;;
  system)
    [ "${1:-}" = df ] || { echo "docker-stub: system $* nicht emuliert" >&2; exit 1; }
    if [ "${2:-}" = -v ]; then cat "$FIX/tools/docker/system-df-v.${CT:-host}" 2>/dev/null
    else cat "$FIX/tools/docker/system-df.txt" 2>/dev/null; fi;;
  compose)
    [ "${1:-}" = "-p" ] || { echo "docker-stub: compose nur mit -p emuliert" >&2; exit 1; }
    proj=$2 sub=${3:-}; shift 3
    case "$sub" in
      logs)
        echo "STUB-COMPOSE $proj logs"
        if [ -n "${STUB_LOGS_SLEEP:-}" ]; then touch "$FIX/.logs-running"; exec sleep "$STUB_LOGS_SLEEP"; fi;;
      ps)
        echo "STUB-COMPOSE $proj ps"
        rows | awk -F'|' -v p="$proj" '$7==p {print $1, $3, $4}';;
      restart|stop|start)
        echo "STUB-COMPOSE $proj $sub"; exit "${STUB_ACTION_RC:-0}";;
      *) echo "docker-stub: compose $sub nicht emuliert (up/pull/down sind in Phase 1 tabu)" >&2; exit 1;;
    esac;;
  *)
    echo "docker-stub: nicht emuliert: $cmd $*" >&2; exit 1;;
esac
